# Copy this file to .env and fill in your own key. Never commit the real .env.
OPENAI_API_KEY=sk-...

# Optional overrides
OPENAI_MODEL=gpt-5

# "medium" (default) is what the committed eval results were generated with --
# slower but more thorough. Set to "low" for faster, less thorough manual test
# runs (e.g. via the web UI); don't change the eval's own results without
# noting that the committed numbers used "medium".
AGENT_REASONING_EFFORT=medium

# Optional: fill these in from https://platform.openai.com/docs/pricing for your model
# to get real cost numbers in results/summary.md. Left blank, cost is reported as N/A.
OPENAI_INPUT_PRICE_PER_MTOK=
OPENAI_OUTPUT_PRICE_PER_MTOK=
