# Copy this file to .env and fill in your own key. Never commit the real .env.
OPENAI_API_KEY=sk-...

# Optional overrides
OPENAI_MODEL=gpt-5

# Optional: fill these in from https://platform.openai.com/docs/pricing for your model
# to get real cost numbers in results/summary.md. Left blank, cost is reported as N/A.
OPENAI_INPUT_PRICE_PER_MTOK=
OPENAI_OUTPUT_PRICE_PER_MTOK=
